# Copie este arquivo para .env e preencha com valores reais no ambiente local.
# O arquivo .env fica ignorado pelo Git.

MSSQL_DATABASE=FormDB
MSSQL_SA_PASSWORD=defina-uma-senha-forte-local

JWT_KEY=defina-uma-chave-jwt-com-pelo-menos-32-bytes
JWT_ISSUER=form-api
JWT_AUDIENCE=form-client
JWT_EXPIRATION_MINUTES=120
